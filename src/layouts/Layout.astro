---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PROEMES | Asociación de Profesionales, Empresarios y Estudiantes Universitarios',
  description = 'PROEMES — Asociación de Profesionales, Empresarios y Estudiantes Universitarios. Lema: Mi profesión al servicio de mi comunidad.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080c" />

    <!-- Tipografía Geométrica Futurista y Ejecutiva: Space Grotesk + Outfit + Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://www.facebook.com/aproemes" />
    <meta property="og:image" content="/images/hero.png" />

    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">
      Saltar al contenido principal
    </a>
    <slot />
  </body>
</html>
